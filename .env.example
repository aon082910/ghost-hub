# Public URL the app is reached at (used for the OAuth redirect URI).
APP_URL=http://localhost:3000

# Single-user login password for the web UI.
# Choose a long passphrase (12+ characters). The app refuses common placeholder values.
ADMIN_PASSWORD=

# 32-byte key, base64. Generate: openssl rand -base64 32
# Encrypts OAuth tokens at rest. Losing it means reconnecting your inbox.
ENCRYPTION_KEY=

# Postgres (matches docker-compose.yml)
POSTGRES_USER=ghosthub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ghosthub
DATABASE_URL=postgres://ghosthub:change-me@localhost:5432/ghosthub

# Every mail provider is optional. Set up the ones you use.
# You can leave all of the lines below empty and enter them later on the Settings page in the app instead.
# Anything saved there wins over what is here.

# Gmail: Google OAuth client (see docs/SETUP-GOOGLE-OAUTH.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Hotmail / Microsoft 365: Entra app registration (see docs/SETUP-MICROSOFT-OAUTH.md)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = personal + work/school accounts. Use "consumers" for personal only, or a tenant id.
MICROSOFT_TENANT=common

# Yahoo / AOL / iCloud / other IMAP: no server config needed. You enter an app password in the UI
# (see docs/SETUP-YAHOO-IMAP.md).

# Breach checking uses Have I Been Pwned (HIBP).
# By default Ghost-Hub downloads HIBP's free public breach list and matches it to your services by domain.
# Nothing about you is sent. Set to false to make no calls to HIBP at all.
HIBP_ENABLED=true
# Optional: your own HIBP API key (paid, haveibeenpwned.com/API/Key). With it you can check whether your
# connected email addresses appear in breaches, which marks those breaches as confirmed. That sends the
# address to HIBP, and only when you press Check on the dashboard.
HIBP_API_KEY=
