# Public URL the app is reached at (used for the OAuth redirect URI).
APP_URL=http://localhost:3000

# Single-user login password for the web UI.
ADMIN_PASSWORD=change-me

# 32-byte key, base64. Generate: openssl rand -base64 32
# Encrypts OAuth tokens at rest. Losing it means reconnecting your inbox.
ENCRYPTION_KEY=

# Postgres (matches docker-compose.yml)
POSTGRES_USER=ghosthub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ghosthub
DATABASE_URL=postgres://ghosthub:change-me@localhost:5432/ghosthub

# Google OAuth client (see docs/SETUP-GOOGLE-OAUTH.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Have I Been Pwned API key for per-email breach lookups.
# Without it, Ghost-Hub matches your discovered services against HIBP's free public breach list.
HIBP_API_KEY=
